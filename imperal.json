              "label": {
                "title": "Label",
                "type": "string"
              },
              "tenant_hostname": {
                "title": "Tenant Hostname",
                "type": "string"
              }
            },
            "required": [
              "id",
              "label",
              "tenant_hostname"
            ],
            "title": "ConnectionInfo",
            "type": "object"
          }
        },
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/ConnectionInfo"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "title": "ListConnectionsResult",
        "type": "object"
      },
      "event": "qlik-connector.disconnect_qlik",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tool_qlik-connector_chat"
    },
