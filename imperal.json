        },
        "required": [
          "connection_id"
        ],
        "title": "DisconnectQlikParams",
        "type": "object"
      },
      "return_schema": {
        "$defs": {
          "ConnectionInfo": {
            "properties": {
              "id": {
                "title": "Id",
                "type": "string"
