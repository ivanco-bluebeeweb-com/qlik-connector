{
  "manifest_schema_version": 3,
  "sdk_version": "5.11.0",
  "app_id": "qlik-connector",
  "version": "0.1.0",
  "name": "Qlik",
  "description": "Connect your own Qlik Cloud tenant (API key) to manage Spaces, apps and reload tasks from Imperal -- trigger data reloads, monitor task history, manage data connections and users. Nothing is hosted or proxied by Imperal beyond the request itself.",
  "icon": "icon.svg",
  "actions_explicit": true,
  "system": false,
  "capabilities": [
    "qlik:read",
    "qlik:write"
  ],
  "tools": [
    {
      "name": "connect_qlik",
      "description": "Connect a Qlik Cloud tenant via API key, after validating the credentials actually work (lists spaces).",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "qlik.provider.connected"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "tenant_hostname": {
            "description": "Qlik Cloud tenant hostname, e.g. mytenant.us.qlikcloud.com",
            "title": "Tenant Hostname",
            "type": "string"
          },
          "api_key": {
            "description": "API key created in Management Console > Settings > API keys.",
            "title": "Api Key",
            "type": "string"
          },
          "label": {
            "default": "",
            "description": "Optional friendly label, e.g. 'Production tenant'.",
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "tenant_hostname",
          "api_key"
        ],
        "title": "ConnectQlikParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "tenant_hostname": {
            "title": "Tenant Hostname",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "tenant_hostname"
        ],
        "title": "ConnectionInfo",
        "type": "object"
      },
      "event": "qlik-connector.connect_qlik",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tool_qlik-connector_chat"
    },
    {
      "name": "disconnect_qlik",
      "description": "Disconnect a Qlik Cloud tenant: deletes only the saved credentials. Nothing in Qlik itself is changed.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "qlik.provider.disconnected"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "connection_id": {
            "description": "Connection id from list_connections.",
            "title": "Connection Id",
            "type": "string"
